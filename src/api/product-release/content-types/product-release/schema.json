{
  "kind": "collectionType",
  "collectionName": "product_releases",
  "info": {
    "singularName": "product-release",
    "pluralName": "product-releases",
    "displayName": "Product Release"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "version": {
      "type": "string",
      "required": true
    },
    "release_date": {
      "type": "datetime",
      "required": false
    },
    "components": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::component.component",
      "mappedBy": "product_releases"
    },
    "process_assessment": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::process-assessment.process-assessment"
    }
  }
}
